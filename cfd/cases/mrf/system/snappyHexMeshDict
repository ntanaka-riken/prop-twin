FoamFile { version 2.0; format ascii; class dictionary; object snappyHexMeshDict; }
// stage-2 MRF mesh: mesh_test + wall layers on the blades and hub. levels.<LEVEL> sets the refinement near the rotor,
// layers.<LAYERS> the wall layers (the thin blades make snappyHexMesh drop layers easily).
#include "levels"
castellatedMesh true; snap true; addLayers true;
geometry
{
    blades.stl { type triSurfaceMesh; name blades; }
    hub.stl    { type triSurfaceMesh; name hub; }
    motor.stl  { type triSurfaceMesh; name motor; }
    cup.stl    { type triSurfaceMesh; name cup; }
    scale.stl  { type triSurfaceMesh; name scale; }
    board.stl  { type triSurfaceMesh; name board; }
    rotorRegion { type cylinder; point1 (0 0 0.1150); point2 (0 0 0.1400); radius 0.0370; }
    gap        { type cylinder; point1 (0 0 0.1185); point2 (0 0 0.1205); radius 0.0120; }   // boss to hub bottom, where the MRF zone ends
    wake       { type cylinder; point1 (0 0 0.090); point2 (0 0 0.260); radius 0.045; }
}
castellatedMeshControls
{
    maxLocalCells 30000000; maxGlobalCells 400000000; minRefinementCells 10; maxLoadUnbalance 0.10; nCellsBetweenLevels 3;
    features ( { file "blades.eMesh"; level $bladeMax; } { file "hub.eMesh"; level $hub; } { file "motor.eMesh"; level 4; } { file "cup.eMesh"; level 4; } );
    refinementSurfaces
    {
        blades { level ($bladeMin $bladeMax); patchInfo { type wall; } }
        hub    { level ($hub $hub); patchInfo { type wall; } }
        motor  { level (4 4); patchInfo { type wall; } }
        cup    { level (3 4); patchInfo { type wall; } }
        scale  { level (2 2); patchInfo { type wall; } }
        board  { level (2 2); patchInfo { type wall; } }
    }
    resolveFeatureAngle 30;
    refinementRegions
    {
        rotorRegion { mode inside; levels ((1e15 $rotor)); }
        gap         { mode inside; levels ((1e15 5)); }
        wake        { mode inside; levels ((1e15 $wake)); }
    }
    locationInMesh (0.2 0.2 0.4);
    allowFreeStandingZoneFaces true;
}
snapControls { nSmoothPatch 3; tolerance 2.0; nSolveIter 50; nRelaxIter 5; nFeatureSnapIter 10; implicitFeatureSnap false; explicitFeatureSnap true; multiRegionFeatureSnap false; }
addLayersControls
{
    #include "layers"            // layers.<LAYERS>: thickness model and layer counts
    nGrow 0; slipFeatureAngle 30; nRelaxIter 5; nSmoothSurfaceNormals 1; nSmoothNormals 3; nSmoothThickness 10;
    maxFaceThicknessRatio 0.5; minMedialAxisAngle 90; nBufferCellsNoExtrude 0; nLayerIter 50; nRelaxedIter 20;
}
meshQualityControls   // the spack build has no etc/caseDicts/mesh/generation, so the usual values are written out;
                      // minVol is in m3 and must be far below a 15 um x 0.06 mm x 0.06 mm layer cell
{
    maxNonOrtho 65; maxBoundarySkewness 20; maxInternalSkewness 4; maxConcave 80; minVol 1e-20; minTetQuality 1e-15;
    minArea -1; minTwist 0.02; minDeterminant 0.001; minFaceWeight 0.05; minVolRatio 0.01; minTriangleTwist -1;
    nSmoothScale 4; errorReduction 0.75; relaxed { maxNonOrtho 75; }
}
mergeTolerance 1e-6;
