FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }
// times (here for 3067 rpm) are reset by Allrun from the speed: end after REVS revolutions, write every 5, average from AVG on
application pimpleFoam; startFrom latestTime; startTime 0; stopAt endTime; endTime 0.587;
deltaT 1e-6; adjustTimeStep yes; maxCo 0.9; maxDeltaT 2e-5;
writeControl adjustable; writeInterval 0.0978; purgeWrite 2; writeFormat binary; writePrecision 8; timePrecision 8; runTimeModifiable true;
// forces in N (rho 1.20), moments about the rotor axis; the balance reads -(sum of Fz over the weighed parts) / g
fo { type forces; libs (forces); rho rhoInf; rhoInf 1.20; CofR (0 0 0); writeControl timeStep; writeInterval 1; log false; }
functions
{
    rotor  { $fo; patches (blades hub); }
    blades { $fo; patches (blades); }
    hub    { $fo; patches (hub); }
    motor  { $fo; patches (motor); }
    cup    { $fo; patches (cup); }
    scale  { $fo; patches (scale); }
    board  { $fo; patches (board); }
    AMIWeights { type AMIWeights; libs (fieldFunctionObjects); writeFields false; writeControl writeTime; }
    average
    {
        type fieldAverage; libs (fieldFunctionObjects); timeStart 0.293; writeControl writeTime;
        fields ( U { mean on; prime2Mean on; base time; } p { mean on; prime2Mean on; base time; } );
    }
}
