FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers
{
    "pcorr.*" { solver GAMG; smoother GaussSeidel; tolerance 1e-2; relTol 0; maxIter 50; }
    p { solver GAMG; smoother GaussSeidel; tolerance 1e-6; relTol 0.05; }
    pFinal { $p; relTol 0; }
    "U.*" { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-8; relTol 0; }
}
PIMPLE { correctPhi no; nOuterCorrectors 1; nCorrectors 2; nNonOrthogonalCorrectors 1; }
